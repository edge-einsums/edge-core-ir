# Dijkstra (single-source shortest paths) -- ASCII surface form of einsum.md
# from convos with Claude AI
#
# Lineage: Bellman-Ford with a priority queue. Same relax/improve/record/update
# body; adds a PICK (closest queued vertex) on top and queue maintenance below.
# Operator legend: <<< = populate; 1(...) = identity compute op;
#   <-(take_left_only) = take_left compute over the take_left_only merge
#     (keep the left value where the right is absent; paper symbol ⊖l).

- Tensors
G^{S = |V|, D = |V|}      -> integer, empty = inf     # edge weights
N^{I, D = |V|}            -> integer, empty = inf     # relaxed candidate distances
C^{I, D = |V|}            -> Boolean, empty = False   # improve mask (N < D)
NewlyRelaxed^{I, D = |V|} -> integer, empty = inf     # improved candidates
D^{I, S = |V|}            -> integer, empty = inf     # distances (the answer)
Q^{I, S = |V|}            -> Boolean, empty = False   # queue membership (yes/no)
DQ^{I, S = |V|}           -> integer, empty = inf     # distances of queued vertices
F^{I, S = |V|}            -> integer, empty = inf     # the one picked (settled) vertex
T^{I, D = |V|}            -> Boolean, empty = False   # queue minus the picked vertex

- Initialization         # source = root
G    -> <user-specified>
root -> <user-specified>          # source coordinate set over rank S
D_{0, s : s in root} = 0
Q_{0, s : s in root} = True

- Extended Einsum        # one vertex settled per iteration i
# PICK: distances of queued vertices, then the closest one
DQ_{i, s}           = Q_{i, s} . D_{i, s}            :: /\_s ->(∩)
F_{i, s*}           = DQ_{i, s}                       :: <<<_s* 1(select-min-s)
# RELAX from the picked vertex
N_{i, d}            = G_{s, d} . F_{i, s}            :: /\_s +(∩) \/_s min(∪)
# IMPROVE / RECORD / UPDATE  (identical to Bellman-Ford)
C_{i, d}            = N_{i, d} . D_{i, d}            :: /\_d <(∪)
NewlyRelaxed_{i, d} = C_{i, d} . N_{i, d}            :: /\_d ->(∩)
D_{i+1, d}          = D_{i, d} . NewlyRelaxed_{i, d} :: /\_d <<(∪)
# QUEUE: drop the settled vertex (occupancy filter), enqueue whoever improved
T_{i, d}            = Q_{i, d} . F_{i, d}            :: /\_d <-(take_left_only)
Q_{i+1, d}          = T_{i, d} . C_{i, d}            :: /\_d OR(∪)
# STOP: queue empty
<> : ||Q_{i+1}|| == 0
